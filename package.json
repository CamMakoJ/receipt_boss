{
  "name": "receipt-boss",
  "version": "0.1.0",
  "description": "Self-hosted, offline-capable receipt tracker with project reports",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
